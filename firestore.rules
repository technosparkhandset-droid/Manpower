rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global security fallback net (Pillar 4)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable, hardened security primitives (Pillar 3)
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role verification (relying on both token email bootstrapped access & firestore records)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'technosparkhandset@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Hardened Schemas & Field Protections
    function isValidUser(user) {
      return user.id is string && user.id.size() <= 128
        && user.email is string && user.email.size() <= 200
        && user.role is string && user.role.size() <= 50;
    }

    function isValidProfile(profile) {
      return profile.id is string && profile.id.size() <= 128
        && profile.fullName is string && profile.fullName.size() <= 200
        && profile.phone is string && profile.phone.size() <= 50
        && profile.role is string && profile.role.size() <= 50;
    }

    function isValidJob(job) {
      return job.id is string && job.id.size() <= 128
        && job.title is string && job.title.size() <= 200
        && job.description is string && job.description.size() <= 2000
        && job.category is string && job.category.size() <= 100
        && job.budget is string && (job.budget is string || job.budget is number);
    }

    // Users Collection Schema Enforcer & Secure Actions
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Profiles Collection Shield (Pillar 2)
    match /profiles/{profileId} {
      allow read: if isAdmin() || (
        resource != null && (resource.data.isPublic == true || isOwner(resource.data.user))
      );
      
      allow create: if isSignedIn() && isValidProfile(request.resource.data) && request.resource.data.user == request.auth.uid;
      
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(resource.data.user) && 
          isValidProfile(request.resource.data) &&
          request.resource.data.user == resource.data.user &&
          // Prevent standard users from modifying admin fields (Pillar 6)
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verification', 'rating', 'isPremium', 'jobsCompleted']))
        )
      );
      
      allow delete: if isAdmin() || (resource != null && isOwner(resource.data.user));
    }

    // Jobs Collection Board (Pillar 8)
    match /jobs/{jobId} {
      allow read: if true; // Public access to jobs board
      allow create: if isSignedIn() && isValidJob(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() || (
          isOwner(resource.data.userId) &&
          isValidJob(request.resource.data) &&
          request.resource.data.userId == resource.data.userId
        )
      );
      allow delete: if isAdmin() || (resource != null && isOwner(resource.data.userId));
    }

    // Admin & Analytics collection Access Control
    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() || isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
